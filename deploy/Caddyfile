	email {$EMAIL_SSL}
}

(comum) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy app:8000
}

{$DOMINIO_GESTAO} {
	import comum
}

{$DOMINIO_PM} {
	import comum
}

{$DOMINIO_CM} {
	import comum
}
