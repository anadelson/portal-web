# Copie para .env e troque os valores. Nunca envie o .env para o Git.
DOMINIO_GESTAO=gestao.conectatech.tech
DOMINIO_PM=pmbora.conectatech.tech
DOMINIO_CM=cmbora.conectatech.tech
EMAIL_SSL=troque@conectatech.tech

PG_USER=portal
PG_PASSWORD=troque-por-uma-senha-longa
PG_HOST=db
PG_PORT=5432

# Chave para assinar cookies de sessão (gere com: openssl rand -hex 32)
SECRET_KEY=troque-por-64-caracteres-aleatorios

# Senha inicial do gestor (console) e dos administradores dos órgãos.
# Troque no primeiro acesso.
SENHA_INICIAL_GESTOR=troque-agora
SENHA_INICIAL_ADMIN=troque-agora

# Data simulada para testes do período eleitoral (vazio = data real)
DATA_SIMULADA=
