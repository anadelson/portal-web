# Copie para .env e troque os valores. Nunca envie o .env para o Git.
DOMINIO_GESTAO=gestao.conectatech.tech
DOMINIO_PM=pmbora.conectatech.tech
DOMINIO_CM=cmbora.conectatech.tech
EMAIL_SSL=troque@conectatech.tech

PG_USER=portal
PG_PASSWORD=troque-por-uma-senha-longa
PG_HOST=db
PG_PORT=5432

# Chave para assinar cookies de sessão (gere com: openssl rand -hex 32)
SECRET_KEY=troque-por-64-caracteres-aleatorios

# Senha inicial do gestor (console) e dos administradores dos órgãos.
# Troque no primeiro acesso.
SENHA_INICIAL_GESTOR=troque-agora
SENHA_INICIAL_ADMIN=troque-agora

# Data simulada para testes do período eleitoral (vazio = data real)
DATA_SIMULADA=

# ---------- Fase 6: Diário Oficial assinado, gov.br e segurança ----------
# Modo do Diário: "teste" (certificados de TESTE, ACT de teste, marca "SEM VALOR OFICIAL") ou "oficial".
DIARIO_MODO=teste
# Senhas dos certificados A1 (um por signatário designado; o NOME da variável é informado em /admin/diario/config).
# Os arquivos .p12 ficam em /opt/portal_web/segredos/a1/ (chmod 600). Exemplo:
A1_SENHA_RESPONSAVEL=
# Autoridade de Carimbo do Tempo (RFC 3161) do contrato (ex.: Serpro, Prodesp):
ACT_URL=
ACT_USUARIO=
ACT_SENHA=
# Login Único gov.br (após a liberação do órgão): ambiente staging (homologação) ou producao
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
GOVBR_AMBIENTE=staging
GOVBR_NIVEL_MINIMO=prata
# Chave do HMAC do CPF (gere com: openssl rand -hex 32). Sem ela, o login gov.br fica desligado.
CPF_HMAC_CHAVE=
# Chave Fernet que cifra os segredos do autenticador (gere com: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
TOTP_CHAVE=
SESSAO_INATIVIDADE_MIN=30
# ---------- Fase 7: credenciais de fontes ----------
# Chave Fernet que cifra as credenciais cadastradas no console (Credenciais de fontes). Gere na VPS sem exibir:
#   grep -q '^CHAVE_CREDENCIAIS=.' .env || python3 -c "import base64,os;print('CHAVE_CREDENCIAIS='+base64.urlsafe_b64encode(os.urandom(32)).decode())" >> .env
# Perder esta chave obriga a recadastrar as credenciais. Ela entra no backup do .env (deploy/backup.sh).
CHAVE_CREDENCIAIS=
# Reserva do IEG-M (a credencial principal é cadastrada no console). Só no .env da VPS, nunca no git nem no chat.
IEGM_USUARIO=
IEGM_SENHA=
